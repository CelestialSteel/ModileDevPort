<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE8E8">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="25dp">
        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Registration Form"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <!-- Roll Number Label -->
        <TextView
            android:id="@+id/rollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Roll no. :"
            app:layout_constraintTop_toTopOf="@id/roll"
            app:layout_constraintBottom_toBottomOf="@id/roll"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:id="@+id/roll"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:inputType="number"
            android:background="@android:drawable/edit_text"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toEndOf="@id/rollLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="35dp"
            android:layout_marginTop="35dp"/>
        <!-- Student Name -->
        <TextView
            android:id="@+id/nameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student name :"
            app:layout_constraintTop_toTopOf="@id/firstName"

            app:layout_constraintBottom_toBottomOf="@id/firstName"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:id="@+id/firstName"
            android:layout_width="95dp"
            android:layout_height="40dp"
            android:hint="First Name"
            app:layout_constraintTop_toBottomOf="@id/roll"
            app:layout_constraintStart_toEndOf="@id/nameLabel"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"/>
        <EditText
            android:id="@+id/lastName"
            android:layout_width="95dp"
            android:layout_height="40dp"
            android:hint="Last Name"
            app:layout_constraintTop_toTopOf="@id/firstName"
            app:layout_constraintStart_toEndOf="@id/firstName"
            android:layout_marginStart="10dp"/>
        <!-- Father's Name -->
        <TextView
            android:id="@+id/fatherLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Father's name :"
            app:layout_constraintTop_toTopOf="@id/father"
            app:layout_constraintBottom_toBottomOf="@id/father"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:id="@+id/father"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@id/firstName"
            app:layout_constraintStart_toEndOf="@id/fatherLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"/>
        <!-- Date of Birth -->
        <TextView
            android:id="@+id/dobLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date of birth :"
            app:layout_constraintTop_toTopOf="@id/day"
            app:layout_constraintBottom_toBottomOf="@id/day"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:id="@+id/day"
            android:layout_width="45dp"
            android:layout_height="35dp"
            android:hint="Day"
            app:layout_constraintTop_toBottomOf="@id/father"
            app:layout_constraintStart_toEndOf="@id/dobLabel"
            android:layout_marginStart="20dp"/>
        <EditText
            android:id="@+id/month"
            android:layout_width="55dp"
            android:layout_height="35dp"
            android:hint="Month"
            app:layout_constraintTop_toTopOf="@id/day"
            app:layout_constraintStart_toEndOf="@id/day"
            android:layout_marginStart="8dp"/>
        <EditText
            android:id="@+id/year"
            android:layout_width="55dp"
            android:layout_height="35dp"
            android:hint="Year"
            app:layout_constraintTop_toTopOf="@id/day"
            app:layout_constraintStart_toEndOf="@id/month"
            android:layout_marginStart="8dp"/>
        <TextView
            android:id="@+id/dateHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(DD-MM-YYYY)"
            app:layout_constraintTop_toTopOf="@id/day"
            app:layout_constraintBottom_toBottomOf="@id/day"
            app:layout_constraintStart_toEndOf="@id/year"
            android:layout_marginStart="8dp"/>
        <!-- Mobile -->
        <TextView
            android:id="@+id/mobileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile no. :"
            app:layout_constraintTop_toTopOf="@id/mobile"
            app:layout_constraintBottom_toBottomOf="@id/mobile"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:id="@+id/mobile"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:hint="Phone number"
            app:layout_constraintTop_toBottomOf="@id/day"
            app:layout_constraintStart_toEndOf="@id/mobileLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="25dp"
            android:layout_marginTop="10dp"/>
        <!-- Email -->
        <TextView
            android:id="@+id/emailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email id :"
            app:layout_constraintTop_toTopOf="@id/email"
            app:layout_constraintBottom_toBottomOf="@id/email"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:id="@+id/email"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@id/mobile"
            app:layout_constraintStart_toEndOf="@id/emailLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="40dp"/>
        <!-- Password -->
        <TextView
            android:id="@+id/passLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password :"
            app:layout_constraintTop_toTopOf="@id/password"

            app:layout_constraintBottom_toBottomOf="@id/password"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:id="@+id/password"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:inputType="textPassword"
            app:layout_constraintTop_toBottomOf="@id/email"
            app:layout_constraintStart_toEndOf="@id/passLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="30dp"/>
        <!-- Gender -->
        <TextView
            android:id="@+id/genderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gender :"
            app:layout_constraintTop_toBottomOf="@id/password"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="15dp"/>
        <RadioButton
            android:id="@+id/male"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Male"
            app:layout_constraintTop_toTopOf="@id/genderLabel"

            app:layout_constraintStart_toEndOf="@id/genderLabel"/>
        <RadioButton
            android:id="@+id/female"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Female"
            app:layout_constraintTop_toTopOf="@id/male"
            app:layout_constraintStart_toEndOf="@id/male"/>
        <!-- Register Button -->
        <Button
            android:id="@+id/register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register"

            app:layout_constraintTop_toBottomOf="@id/genderLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="250dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
